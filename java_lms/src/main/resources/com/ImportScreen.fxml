<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="580" prefWidth="750" spacing="12"
      style="-fx-background-color: #f0f4f8;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.ImportController">

    <padding>
        <Insets topRightBottomLeft="25"/>
    </padding>

    <!-- Screen heading -->
    <Label style="-fx-text-fill: #1a252f; -fx-font-family: Arial; -fx-font-size: 20px; -fx-font-weight: BOLD;"
           text="Import CSV Files"/>

    <!-- File path grid -->
    <GridPane hgap="10" vgap="10">
        <padding>
            <Insets topRightBottomLeft="10"/>
        </padding>

        <!-- Row 0: Book file -->
        <Label text="Book File:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="tfBooks" prefWidth="350" text="book.csv"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Button onAction="#handleBrowseBooks" text="Browse"
                GridPane.columnIndex="2" GridPane.rowIndex="0"/>

        <!-- Row 1: Student file -->
        <Label text="Student File:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="tfStudents" prefWidth="350" text="student.csv"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Button onAction="#handleBrowseStudents" text="Browse"
                GridPane.columnIndex="2" GridPane.rowIndex="1"/>

        <!-- Row 2: Transaction file -->
        <Label text="Transaction File:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="tfTrans" prefWidth="350" text="transactions.csv"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Button onAction="#handleBrowseTrans" text="Browse"
                GridPane.columnIndex="2" GridPane.rowIndex="2"/>

        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="70"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
        </rowConstraints>
    </GridPane>

    <!-- Import + Back buttons -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="btnImport"
                onAction="#handleImport"
                text="Import Files"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 18; -fx-cursor: hand;"/>
        <Button fx:id="btnBack"
                onAction="#handleBack"
                text="← Back to Menu"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 18; -fx-cursor: hand;"/>
    </HBox>

    <Separator/>

    <!-- Edit section label -->
    <Label text="Edit Records (import files first, then use these buttons to correct any invalid data):"
           style="-fx-text-fill: #2c3e50; -fx-font-size: 12px; -fx-font-weight: BOLD;"/>

    <!-- Three edit buttons — one per record type -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="btnEditBooks"
                onAction="#handleEditRecord"
                text="Edit Book Records"
                style="-fx-background-color: #185FA5; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 18; -fx-cursor: hand;"/>
        <Button fx:id="btnEditStudents"
                onAction="#handleEditStudentRecord"
                text="Edit Student Records"
                style="-fx-background-color: #0F6E56; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 18; -fx-cursor: hand;"/>
        <Button fx:id="btnEditTransactions"
                onAction="#handleEditTransactionRecord"
                text="Edit Transaction Records"
                style="-fx-background-color: #854F0B; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 18; -fx-cursor: hand;"/>
    </HBox>

    <Separator/>

    <!-- Validation results label + area -->
    <Label text="Validation Results:"/>
    <TextArea fx:id="taErrors"
              editable="false"
              prefHeight="160"
              promptText="Validation messages will appear here after importing..."
              style="-fx-font-family: monospace; -fx-font-size: 12;"/>

</VBox>
