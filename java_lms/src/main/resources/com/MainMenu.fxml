<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="520" prefWidth="500" spacing="20" style="-fx-background-color: #1e2a3a;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.MainMenuController">

    <padding>
        <Insets topRightBottomLeft="40" />
    </padding>

    <Label style="-fx-text-fill: #e8f4fd; -fx-font-family: Arial; -fx-font-size: 26px; -fx-font-weight: BOLD;" text="Library Management System" />

    <Label style="-fx-text-fill: #90b8d8; -fx-font-family: Arial; -fx-font-size: 14px;" text="CM1601 - Java FX Module" />

    <Separator />

    <Button fx:id="btnImport" onAction="#handleImport" style="-fx-background-color: #2c3e50; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-min-width: 280px; -fx-padding: 12 20; -fx-cursor: hand;" text="1.  Import CSV Files">
    </Button>

    <Button fx:id="btnReport" onAction="#handleReport" style="-fx-background-color: #2c3e50; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-min-width: 280px; -fx-padding: 12 20; -fx-cursor: hand;" text="2.  Books Issued Report">
    </Button>

    <Button fx:id="btnAvgCost" onAction="#handleAvgCost" style="-fx-background-color: #2c3e50; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-min-width: 280px; -fx-padding: 12 20; -fx-cursor: hand;" text="3.  Average Cost of Books">
    </Button>

    <Button fx:id="btnSearch" onAction="#handleSearch" style="-fx-background-color: #2c3e50; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-min-width: 280px; -fx-padding: 12 20; -fx-cursor: hand;" text="4.  Search Books by Title">
    </Button>

    <Separator />

    <Button fx:id="btnExit" onAction="#handleExit" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-size: 14px; -fx-min-width: 280px; -fx-padding: 12 20; -fx-cursor: hand;" text="     Exit">
    </Button>

</VBox>
