<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="520" prefWidth="700" spacing="15" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.SearchController">

    <padding>
        <Insets topRightBottomLeft="25" />
    </padding>

    <!-- Screen heading -->
    <Label style="-fx-text-fill: #1a252f; -fx-font-family: Arial; -fx-font-size: 20px; -fx-font-weight: BOLD;" text="Search Books by Title" />

    <!-- Hint label -->
    <Label style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;" text="Tip: Use wildcard '*' at end, e.g. 'Java*' to match all Java titles." />

    <!-- Search input row -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Title:" />
        <TextField fx:id="tfQuery" prefWidth="250" promptText="Enter title or title prefix*" />
        <Button fx:id="handleSearch" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 18; -fx-cursor: hand;" text="Search">
        </Button>
    </HBox>

    <!-- Result count label -->
    <Label fx:id="lblCount" />

    <!-- Results table -->
    <TableView fx:id="table" prefHeight="260">
        <columns>
            <TableColumn fx:id="colID" prefWidth="80" text="Book ID" />
            <TableColumn fx:id="colTitle" prefWidth="160" text="Title" />
            <TableColumn fx:id="colAuth" prefWidth="130" text="Author" />
            <TableColumn fx:id="colISBN" prefWidth="130" text="ISBN-13" />
            <TableColumn fx:id="colAvail" prefWidth="80" text="Available" />
            <TableColumn fx:id="colPrice" prefWidth="70" text="Price" />
        </columns>
    </TableView>

    <!-- Action buttons -->
    <HBox spacing="10">
        <Button fx:id="handleExport" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 18; -fx-cursor: hand;" text="Export Results">
        </Button>
        <Button fx:id="handleBack" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 18; -fx-cursor: hand;" text="← Back to Menu">
        </Button>
    </HBox>

</VBox>
